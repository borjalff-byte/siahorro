# Bot Telegram (obtener de @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=

# Tu Telegram User ID (envía un mensaje a @userinfobot para obtenerlo)
TELEGRAM_ALLOWED_USER_ID=

# Google Gemini — gratuito en https://aistudio.google.com/
GEMINI_API_KEY=

# Supabase — copiar de Vercel dashboard (mismos valores)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# ── REELS INSTAGRAM (reels/generar-reel.js) ────────────────────────
# ElevenLabs — voz IA para los reels → elevenlabs.io
ELEVENLABS_API_KEY=

# HeyGen — avatar hablante (solo necesario con --avatar) → heygen.com
HEYGEN_API_KEY=

# Cloudinary — hosting del MP4 final (gratis hasta 25GB) → cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
